<!DOCTYPE html>
<html lang="en">
  <head data-tid="<%= new Date().valueOf() %>">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Cheeky chops in Meanwood, Leeds is a fun place where your child / children can come for their hair cutting">
    <meta name="author" content="Cheeky Chops Haircutting Meanwood Leeds">
    <meta name="theme-color" content="#262626"/>
    <meta name="msapplication-navbutton-color" content="#262626"/>
    <meta name="apple-mobile-web-app-capable" content="yes"/>
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>

    <title>Cheeky Chops - a fun place where the children can come for their hair cutting!</title>
    <!-- Custom Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Grandstander:wght@300;600;700&display=swap" rel="stylesheet">
    <link rel="apple-touch-icon" href="<%= require('./img/apple-touch-icon.png').default %>" sizes="180x180">
    <link rel="icon" href="<%= require('./img/favicon-16x16.png').default %>" sizes="16x16">
    <link rel="icon" href="<%= require('./img/favicon-32x32.png').default %>" sizes="32x32">
    <link rel="shortcut icon" href="<%= require('./img/favicon.ico').default %>">
    <script>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <nav id="mainNav">
        <a class="page-scroll booksy" href="http://cheekychops.booksy.com" target="_blank" name="logo">Book Now</a>
        <button id="navButton" type="button" data-toggle="collapse" data-target="#navbar">
          <span class="sr-only">Toggle navigation</span><i class="fa fa-bars"></i>
        </button>
        <div id="navBar">
          <ul>
            <li>
              <a class="page-scroll" href="#about">About</a>
            </li>
            <li>
              <a class="page-scroll" href="#opening">Opening Times</a>
            </li>
          </ul>
        </div>
    </nav>

    <header id="page-top">
      <h1 class="sr-only">Cheeky Chops haircutting and Rosies Hairdressing.</h1>
            
      <div class="header-content">
        <div class="header-content-inner">
          <div class="header-content-inner-item">
            <a href="#main-content" id="cheeky" aria-label="Skip to main content"></a>
            <p class="cloud" hidden="hidden">Perfect for children who don't like their hair cutting</p>
            <p class="promo">Haircuts for all the family. Specializing in childrens haircuts</p>
            <a class="btn-primary" href="#main-content">Visit Cheeky Chops</a>
          </div>
          <div class="header-content-inner-item">
            <a href="/rosies" id="rosies" aria-label="Rosies hairdressing"></a>
            <p class="promo promo-rosies">A small 1to1 ladies and girls salon</p>
            <a class="btn-primary btn-primary-rosies" href="/rosies">Visit Rosies Hairdressing</a>
          </div>
        </div>
      </div>
    </header>

    <aside class="modal" id="booking_notice" hidden="hidden">
      <div class="inner">
        <h2>Booking advice</h2>
        <p>When making a reservation, please ensure you check and set your stylist (Staff) option to "No preference" as this will help us give you all available booking times. Thanks!</p>
      </div>
    </aside>

    <section id="main-content">
      <div id="about" class="container">
        <div class="container-header">
          <h2 id="about-title">Welcome to Cheeky Chops!</h2>
          <p>We're a children's salon and barbers specialising in children's haircuts, while also offering men's haircuts.</p>
          <p>With fun ride-on cars, toys to enjoy while waiting, and a Nintendo Switch for older children in our barber area, we make haircuts a positive experience for all ages.</p> 
          <p>We also offer extra-time appointments for children with SEN, providing a calm, patient and understanding environment.</p>
          <p>Proudly caring for local families for over 8 years. We can't wait to welcome you! &#10084;</p>
        </div>
      </div>

      <div id="gallery" class="container">
        <div class="container-header">
          <h2 id="gallery-title">Making haircuts more fun and relaxing</h2>
          <div class="gallery-wrap">
            <div class="gallery">
              <img class="gallery-image" src="<%= require.ensure('./img/img10.jpg').default %>" alt="picture of child having hair cut">
              <img class="gallery-image" src="<%= require.ensure('./img/img11.jpg').default %>" alt="picture of child having hair cut">
              <img class="gallery-image" src="<%= require.ensure('./img/img12.jpg').default %>" alt="picture of child having hair cut">
              <img class="gallery-image" src="<%= require.ensure('./img/img13.jpg').default %>" alt="picture of child having hair cut">
              <img class="gallery-image" src="<%= require.ensure('./img/img14.jpg').default %>" alt="picture of child having hair cut">
              <img class="gallery-image" src="<%= require.ensure('./img/img15.jpg').default %>" alt="picture of child having hair cut">
              <img class="gallery-image" src="<%= require.ensure('./img/img16.jpg').default %>" alt="picture of child having hair cut">
              <img class="gallery-image" src="<%= require.ensure('./img/img17.jpg').default %>" alt="picture of child having hair cut">
              <img class="gallery-image" src="<%= require.ensure('./img/img18.jpg').default %>" alt="picture of child having hair cut">
              <img class="gallery-image" src="<%= require.ensure('./img/img19.jpg').default %>" alt="picture of child having hair cut">
              <img class="gallery-image" src="<%= require.ensure('./img/img20.jpg').default %>" alt="picture of child having hair cut">
              <img class="gallery-image" src="<%= require.ensure('./img/img21.jpg').default %>" alt="picture of child having hair cut">
              <img class="gallery-image" src="<%= require.ensure('./img/img22.jpg').default %>" alt="picture of child having hair cut">
              <img class="gallery-image" src="<%= require.ensure('./img/img23.jpg').default %>" alt="picture of child having hair cut">
              <img class="gallery-image" src="<%= require.ensure('./img/img24.jpg').default %>" alt="picture of child having hair cut">
            </div>
          </div>
          <div class="swipe-icon">Swipe for more</div>
        </div>
      </div>

      <div id="reviews" class="container">
        <div class="container-header">
          <h2 id="reviews-title">Reviews</h2>
          <ul class="reviews">
            <li>Very quick service as we only went for a fringe trim, hairdresser was nice and polite, good with my 11 month old who is usually shy. Would go again :)</li>
            <li>My son hates having his hair cut but it was so easy and quick. Although he cried but nothing near as bad as he normally does. He left having a positive experience and we will definitely be booking again Thanks.</li>
            <li>We've been going to Cheeky Chops for a while . I have to say cannot recommend this place enough! The staff are great with kids, also the atmosphere is great.</li>
          </ul>
          <p><a href="http://cheekychops.booksy.com/#reviews-section" target="_blank">Read more of our reviews at Booksy</a></p>
        </div>
      </div>

      <div id="opening" class="container">
        <div class="container-header">
          <h2 id="opening-title">Opening Times</h2>
          <table class="opening-times" id="opening-times-table" data-today="5">
            <thead>
              <tr>
                <th scope="row"><span class="sr-only">Period</span></th>
                <th data-day="1" scope="col">Opens</th>
                <th data-day="2" scope="col">Closes</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Mon</th>
                <td data-day="1" scope="col">Closed</td>
                <td data-day="1" scope="col">-</td>
              </tr>
              <tr>
                <th scope="row">Tue</th>
                <td data-day="2" scope="col">10:00</td>
                <td data-day="2" scope="col">14:45</td>
              </tr>
              <tr>
                <th scope="row">Wed</th>
                <td data-day="3" scope="col">09:15</td>
                <td data-day="3" scope="col">17:30</td>
              </tr>
              <tr>
                <th scope="row">Thu</th>
                <td data-day="4" scope="col">09:15</td>
                <td data-day="4" scope="col">17:30</td>
              </tr>
              <tr>
                <th scope="row">Fri</th>
                <td data-day="5" scope="col">09:15</td>
                <td data-day="5" scope="col">17:30</td>
              </tr>
              <tr>
                <th scope="row">Sat</th>
                <td data-day="6" scope="col">09:00</td>
                <td data-day="6" scope="col">16:00</td>
              </tr>
              <tr>
                <th scope="row">Sun</th>
                <td data-day="7" scope="col">Closed</td>
                <td data-day="7" scope="col">-</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>
    <footer><a href="tel:07713720971">07713&nbsp;720971</a>74 Green Rd, Meanwood, Leeds LS6 4HY</footer>
  </body>
</html>
